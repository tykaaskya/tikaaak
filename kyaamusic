# style.css

```css
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

html{
scroll-behavior:smooth;
}

body{

background:#f9f8f6;
color:#333;

}

nav{

display:flex;
justify-content:space-between;
align-items:center;

padding:25px 8%;

position:fixed;
width:100%;
background:rgba(255,255,255,.9);
backdrop-filter:blur(15px);

z-index:1000;

}

.logo{

font-size:26px;
font-weight:700;

color:#6D4C41;

}

nav ul{

display:flex;
list-style:none;
gap:35px;

}

nav a{

text-decoration:none;
color:#444;

transition:.3s;

}

nav a:hover{

color:#4A90E2;

}

nav button{

padding:12px 24px;

background:#4A90E2;

border:none;

border-radius:30px;

color:white;

cursor:pointer;

font-weight:600;

transition:.3s;

}

nav button:hover{

background:#2b73c8;

}

header{

min-height:100vh;

display:flex;

align-items:center;

justify-content:space-between;

padding:120px 8%;

}

.hero-text{

width:50%;

}

.hero-text h1{

font-size:62px;

line-height:1.2;

margin-bottom:20px;

color:#4E342E;

}

.hero-text p{

font-size:18px;

line-height:1.8;

margin-bottom:35px;

}

.buttons{

display:flex;

gap:20px;

}

.primary{

padding:15px 30px;

background:#6D4C41;

border-radius:40px;

color:white;

text-decoration:none;

}

.secondary{

padding:15px 30px;

border:2px solid #4A90E2;

border-radius:40px;

text-decoration:none;

color:#4A90E2;

}

.hero-image{

width:45%;

display:flex;

justify-content:center;

}

.circle{

width:420px;

height:420px;

background:linear-gradient(135deg,#4A90E2,#A1887F);

border-radius:50%;

display:flex;

align-items:center;

justify-content:center;

font-size:150px;

color:white;

box-shadow:0 20px 50px rgba(0,0,0,.2);

animation:float 4s infinite ease-in-out;

}

@keyframes float{

50%{

transform:translateY(-15px);

}

}

section{

padding:90px 8%;

}

.about h2{

text-align:center;

margin-bottom:60px;

font-size:40px;

}

.cards{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:30px;

}

.card{

background:white;

padding:40px;

border-radius:20px;

box-shadow:0 15px 35px rgba(0,0,0,.08);

transition:.4s;

}

.card:hover{

transform:translateY(-10px);

}

.card i{

font-size:45px;

margin-bottom:20px;

color:#4A90E2;

}

.stats{

display:grid;

grid-template-columns:repeat(4,1fr);

text-align:center;

background:#6D4C41;

color:white;

}

.stats h1{

font-size:50px;

}

.cta{

text-align:center;

}

.cta h2{

font-size:42px;

margin-bottom:20px;

}

.cta p{

margin-bottom:30px;

}

.cta button{

padding:16px 35px;

background:#4A90E2;

border:none;

border-radius:30px;

color:white;

font-size:16px;

cursor:pointer;

}

footer{

padding:40px;

text-align:center;

background:#3E2723;

color:white;

}

.reveal{

opacity:0;

transform:translateY(60px);

transition:1s;

}

.reveal.active{

opacity:1;

transform:translateY(0);

}

@media(max-width:900px){

header{

flex-direction:column;

text-align:center;

}

.hero-text,.hero-image{

width:100%;

}

.hero-image{

margin-top:50px;

}

.cards{

grid-template-columns:1fr;

}

.stats{

grid-template-columns:repeat(2,1fr);

gap:40px;

}

nav ul{

display:none;

}

.hero-text h1{

font-size:45px;

}

.circle{

width:300px;
height:300px;
font-size:100px;

}

}
```

